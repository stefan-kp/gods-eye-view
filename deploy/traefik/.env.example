# Copy to .env beside compose.yml. Never commit real secrets.
# Use an image with the runtime ENV changes from this Docker branch.
# The fork has not yet published an image. Build one or publish after review.
GEV_IMAGE=

# Hostname only: no scheme, path, or port.
APP_DOMAIN=
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=le

# Traefik's IP on the proxy network, for example 172.22.0.2/32.
# Read it on the server. Do not use this example address without a check.
TRAEFIK_TRUSTED_IPS=

# Google OAuth client of type Web application. These are not Google Maps keys.
# Register https://YOUR-DOMAIN/oauth2/callback as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Exact Google account addresses, one per line. A single address also works.
# For example:
# GEV_ALLOWED_EMAILS='alice@example.com
# bob@example.com'
GEV_ALLOWED_EMAILS=

# Public browser credentials. Restrict these to the application domain.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# Private provider credentials. All admitted users share these credentials.
OPENAI_API_KEY=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
LL2_API_TOKEN=
